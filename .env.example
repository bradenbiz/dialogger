# Server (defaults to 127.0.0.1; binding a non-loopback host requires DIALOGGER_API_KEY)
DIALOGGER_HOST=127.0.0.1
DIALOGGER_PORT=4310
# DIALOGGER_API_KEY=
# DIALOGGER_OWNER_KEY=
# Only set on a private tailnet if you intentionally want unauthenticated access on 0.0.0.0:
# DIALOGGER_ALLOW_UNAUTHENTICATED=false

# Local NVIDIA Speech Runtime (NeMo-Speech.cpp)
# Streaming ASR: nemotron-3.5 (nvidia/nemotron-3.5-asr-streaming-0.6b)
# Offline ASR:   parakeet-tdt (nvidia/parakeet-tdt-0.6b-v3) or nemotron-3.5
# Diarization:   nemotron-3-diarization (nvidia/Nemotron-3-Diarization, up to 8 speakers w/ overlap)
NEMO_SPEECH_BIN=nemo-speech
NEMO_SPEECH_HOST=127.0.0.1
NEMO_SPEECH_PORT=8788
NEMO_SPEECH_STREAMING_ASR=nemotron-3.5
NEMO_SPEECH_OFFLINE_ASR=parakeet-tdt
NEMO_SPEECH_DIAR_MODEL=nemotron-3-diarization

# Dialogue Mapping Model (optional — falls back to local heuristic mapper or external Agent API)
# Supports OpenAI-compatible APIs (OpenAI, xAI, OpenRouter, Ollama, LM Studio) or Anthropic.
# DIALOGGER_LLM_PROVIDER=openai-compatible
# DIALOGGER_LLM_BASE_URL=https://api.openai.com/v1
# DIALOGGER_LLM_MODEL=gpt-4.1-mini
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# XAI_API_KEY=
