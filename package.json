{
  "name": "dialogger",
  "repository": "https://github.com/bradenbiz/dialogger",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NITRO_HOST=${DIALOGGER_HOST:-127.0.0.1} NITRO_PORT=${DIALOGGER_PORT:-4310} node .output/server/index.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.108.4",
    "d3-hierarchy": "^3.1.2",
    "lucide-react": "^1.78.0",
    "nitro": "3.0.261103-rc",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
